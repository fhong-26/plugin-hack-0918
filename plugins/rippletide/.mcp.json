{
  "mcpServers": {
    "rippletide": {
      "command": "python3",
      "args": [
        "./scripts/launch.py"
      ],
      "cwd": ".",
      "env_vars": [
        "RIPPLETIDE_MODEL",
        "RIPPLETIDE_DATA_DIR"
      ],
      "startup_timeout_sec": 120,
      "tool_timeout_sec": 120,
      "required": true
    }
  }
}
