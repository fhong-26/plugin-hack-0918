diff --git a/codex-rs/core/tests/suite/jev.rs b/codex-rs/core/tests/suite/jev.rs
new file mode 100644
index 0000000..2836c4f
--- /dev/null
+++ b/codex-rs/core/tests/suite/jev.rs
@@ -0,0 +1,187 @@
+//! Exercise the real sampling loop and MCP transport; no model or Jev weights required.
+#![allow(clippy::unwrap_used)]
+use codex_config::types::McpServerConfig;
+use codex_protocol::config_types::WebSearchMode;
+use core_test_support::responses;
+use core_test_support::test_codex::test_codex;
+use pretty_assertions::assert_eq;
+use serde_json::Value;
+use serde_json::json;
+use std::fs;
+use test_case::test_case;
+
+const SELECTOR: &str = r#"
+import json, sys
+mode, selection, log = sys.argv[1:]
+for line in sys.stdin:
+    request = json.loads(line)
+    if 'id' not in request:
+        continue
+    method = request['method']
+    if method == 'initialize':
+        result = {'protocolVersion': request['params']['protocolVersion'],
+                  'capabilities': {'tools': {}}, 'serverInfo': {'name': mode, 'version': '1'}}
+    elif method == 'tools/list':
+        result = {'tools': [{'name': 'route' if mode == 'selector' else 'lookup',
+                  'description': 'Select a tool' if mode == 'selector' else 'Look up a record',
+                  'inputSchema': {'type': 'object', 'properties': {}}}]}
+    elif method == 'tools/call':
+        args = request['params'].get('arguments', {})
+        if mode == 'selector':
+            with open(log, 'a') as stream:
+                stream.write(json.dumps(args) + '\n')
+            name = next((tool['name'] for tool in args['tools'] if tool['name'].endswith(selection)), selection)
+            result = {'content': [], 'structuredContent': {'status': 'selected', 'tool': name, 'score': 1.0}}
+        else:
+            result = {'content': [{'type': 'text', 'text': 'lookup executed'}]}
+    else:
+        result = {}
+    print(json.dumps({'jsonrpc': '2.0', 'id': request['id'], 'result': result}), flush=True)
+"#;
+
+#[test_case("update_plan"; "native")]
+#[test_case("lookup"; "mcp")]
+#[test_case("web_search"; "hosted")]
+#[test_case("unavailable_tool"; "invalid_selection")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn jev_selects_before_argument_generation(selection: &'static str) -> anyhow::Result<()> {
+    let server = responses::start_mock_server().await;
+    let temp = tempfile::tempdir()?;
+    let script = temp.path().join("selector.py");
+    let log = temp.path().join("calls.jsonl");
+    fs::write(&script, SELECTOR)?;
+    let log_for_config = log.clone();
+    let fixture = test_codex()
+        .with_model("gpt-5.4")
+        .with_config(move |config| {
+            config.update_plan_enabled = true;
+            let mut servers = config.mcp_servers.get().clone();
+            for (name, mode) in [("rippletide", "selector"), ("records", "records")] {
+                let settings: McpServerConfig = serde_json::from_value(json!({
+                    "command": "python3",
+                    "args": [script, mode, selection, log_for_config],
+                    "required": true,
+                    "startup_timeout_sec": 10,
+                }))
+                .unwrap();
+                servers.insert(name.to_string(), settings);
+            }
+            config.mcp_servers.set(servers).unwrap();
+            config.web_search_mode.set(WebSearchMode::Cached).unwrap();
+        })
+        .build_with_auto_env(&server)
+        .await?;
+    let mut replies = Vec::new();
+    if selection == "update_plan" || selection == "lookup" {
+        let (name, arguments) = if selection == "update_plan" {
+            (
+                "update_plan",
+                r#"{"plan":[{"step":"checked","status":"completed"}]}"#,
+            )
+        } else {
+            ("mcp__records__lookup", "{}")
+        };
+        let mut events = vec![responses::ev_response_created("call")];
+        if selection == "update_plan" {
+            events.push(responses::ev_function_call_with_namespace(
+                "wrong",
+                "mcp__records",
+                "lookup",
+                "{}",
+            ));
+        }
+        events.push(if selection == "lookup" {
+            responses::ev_function_call_with_namespace(
+                "call-1",
+                "mcp__records",
+                "lookup",
+                arguments,
+            )
+        } else {
+            responses::ev_function_call("call-1", name, arguments)
+        });
+        if selection == "update_plan" {
+            events.push(responses::ev_function_call("duplicate", name, arguments));
+        }
+        events.push(responses::ev_completed("call"));
+        replies.push(responses::sse(events));
+    }
+    replies.push(responses::sse(vec![
+        responses::ev_response_created("final"),
+        responses::ev_assistant_message("message", "done"),
+        responses::ev_completed("final"),
+    ]));
+    let requests = if selection == "unavailable_tool" {
+        None
+    } else {
+        Some(responses::mount_sse_sequence(&server, replies).await)
+    };
+    fixture
+        .submit_turn("Look up the record and update the plan")
+        .await?;
+    let selections = fs::read_to_string(&log)?
+        .lines()
+        .map(serde_json::from_str::<Value>)
+        .collect::<Result<Vec<_>, _>>()?;
+    let candidates = selections[0]["tools"].as_array().unwrap();
+    let names = candidates
+        .iter()
+        .map(|tool| tool["name"].as_str().unwrap())
+        .collect::<Vec<_>>();
+    assert!(names.contains(&"update_plan"), "{names:?}");
+    assert!(names.contains(&"web_search"));
+    assert!(names.iter().any(|name| name.ends_with("lookup")));
+    assert!(!names.iter().any(|name| name.contains("rippletide")));
+    assert!(
+        selections[0]["question"]
+            .as_str()
+            .unwrap()
+            .contains("Look up the record")
+    );
+    let context: Value = serde_json::from_str(selections[0]["context"].as_str().unwrap())?;
+    assert!(!context["instructions"].as_str().unwrap().is_empty());
+    assert!(!context["messages"].as_array().unwrap().is_empty());
+    if selection == "unavailable_tool" {
+        assert!(
+            !server
+                .received_requests()
+                .await
+                .unwrap()
+                .iter()
+                .any(|request| request.url.path().ends_with("/responses")),
+            "invalid selection must stop before Codex samples"
+        );
+        return Ok(());
+    }
+    let requests = requests.unwrap().requests();
+    assert_eq!(requests.len(), selections.len());
+    for request in &requests {
+        let body = request.body_json();
+        assert_eq!(body["tools"].as_array().unwrap().len(), 1);
+        assert_eq!(body["parallel_tool_calls"], false);
+        let tool = &body["tools"][0];
+        if selection == "web_search" {
+            assert_eq!(tool["type"], "web_search");
+        } else if selection == "lookup" {
+            assert_eq!(tool["name"], "mcp__records");
+            assert_eq!(tool["tools"].as_array().unwrap().len(), 1);
+            assert_eq!(tool["tools"][0]["name"], "lookup");
+        } else {
+            assert!(tool["name"].as_str().unwrap().ends_with(selection));
+        }
+    }
+    if selection == "lookup" {
+        assert!(
+            requests[1].body_json()["input"]
+                .to_string()
+                .contains("lookup executed")
+        );
+    }
+    if selection == "update_plan" {
+        let history = requests[1].body_json()["input"].to_string();
+        assert_eq!(history.matches("Plan updated").count(), 1);
+        assert_eq!(history.matches("unused Jev selection").count(), 2);
+        assert!(!history.contains("lookup executed"));
+    }
+    Ok(())
+}
