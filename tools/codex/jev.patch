+use super::*;
+use codex_tools::ResponsesApiNamespace;
+use codex_tools::ResponsesApiTool;
+use pretty_assertions::assert_eq;
+
+#[test]
+fn namespace_members_and_hosted_tools_are_individual_candidates() {
+    let tools = ["get_issue", "list_comments"].map(|name| {
+        ResponsesApiNamespaceTool::Function(ResponsesApiTool {
+            name: name.to_string(),
+            description: name.to_string(),
+            strict: false,
+            defer_loading: Some(true),
+            parameters: serde_json::from_value(json!({"type": "object", "properties": {}}))
+                .unwrap(),
+            output_schema: None,
+        })
+    });
+    let candidates = catalog(vec![
+        ToolSpec::Namespace(ResponsesApiNamespace {
+            name: "linear".to_string(),
+            description: "Issue tracker".to_string(),
+            tools: tools.to_vec(),
+        }),
+        ToolSpec::WebSearch {
+            external_web_access: None,
+            indexed_web_access: None,
+            filters: None,
+            user_location: None,
+            search_context_size: None,
+            search_content_types: None,
+        },
+    ]);
+    assert_eq!(
+        candidates.keys().cloned().collect::<Vec<_>>(),
+        vec!["linear.get_issue", "linear.list_comments", "web_search"]
+    );
+    let selected = serde_json::to_value(&candidates["linear.list_comments"].spec).unwrap();
+    assert_eq!(selected["tools"].as_array().unwrap().len(), 1);
+    assert_eq!(selected["tools"][0]["name"], "list_comments");
+    assert_eq!(selected["tools"][0].get("defer_loading"), None);
+}
+
+#[test]
+fn mismatches_do_not_consume_selection_and_matching_calls_consume_it_once() {
+    let selection = Selection {
+        name: ToolName::plain("apply_patch").with_default_namespace(),
+        claimed: AtomicBool::new(false),
+    };
+    assert!(!selection.claim(&ToolName::plain("exec_command")));
+    assert!(selection.claim(&ToolName::plain("apply_patch")));
+    assert!(!selection.claim(&ToolName::plain("apply_patch")));
+}
