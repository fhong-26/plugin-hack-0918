diff --git a/codex-rs/core/src/tools/jev.rs b/codex-rs/core/src/tools/jev.rs
new file mode 100644
index 0000000..c81f496
--- /dev/null
+++ b/codex-rs/core/src/tools/jev.rs
@@ -0,0 +1,183 @@
+//! Let the installed local selector choose a tool before Codex generates arguments.
+
+use crate::client_common::Prompt;
+use crate::session::step_context::StepContext;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result;
+use codex_protocol::models::ResponseItem;
+use codex_tools::ResponsesApiNamespaceTool;
+use codex_tools::ToolName;
+use codex_tools::ToolSpec;
+use serde_json::json;
+use std::collections::BTreeMap;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::Ordering;
+use tokio_util::sync::CancellationToken;
+
+pub(crate) struct Selection {
+    pub(crate) name: ToolName,
+    claimed: AtomicBool,
+}
+
+impl Selection {
+    pub(crate) fn claim(&self, name: &ToolName) -> bool {
+        self.name == name.clone().with_default_namespace()
+            && !self.claimed.swap(true, Ordering::SeqCst)
+    }
+}
+
+struct Candidate {
+    name: ToolName,
+    description: String,
+    spec: ToolSpec,
+}
+
+fn key(name: &ToolName) -> String {
+    if name.is_default_namespace() {
+        name.name.clone()
+    } else {
+        format!(
+            "{}.{}",
+            name.namespace.as_deref().unwrap_or("functions"),
+            name.name
+        )
+    }
+}
+
+fn catalog(specs: Vec<ToolSpec>) -> BTreeMap<String, Candidate> {
+    let mut candidates = BTreeMap::new();
+    for mut spec in specs {
+        let (name, description) = match &mut spec {
+            ToolSpec::Function(tool) => {
+                tool.defer_loading = None;
+                (ToolName::plain(&tool.name), tool.description.clone())
+            }
+            ToolSpec::Freeform(tool) => {
+                tool.defer_loading = None;
+                (ToolName::plain(&tool.name), tool.description.clone())
+            }
+            ToolSpec::Namespace(namespace) => {
+                for mut tool in namespace.tools.clone() {
+                    let (name, description) = match &mut tool {
+                        ResponsesApiNamespaceTool::Function(tool) => {
+                            tool.defer_loading = None;
+                            (tool.name.clone(), tool.description.clone())
+                        }
+                        ResponsesApiNamespaceTool::Custom(tool) => {
+                            tool.defer_loading = None;
+                            (tool.name.clone(), tool.description.clone())
+                        }
+                    };
+                    let name = ToolName::namespaced(&namespace.name, name).with_default_namespace();
+                    let mut selected = namespace.clone();
+                    selected.tools = vec![tool];
+                    candidates.insert(
+                        key(&name),
+                        Candidate {
+                            name,
+                            description,
+                            spec: ToolSpec::Namespace(selected),
+                        },
+                    );
+                }
+                continue;
+            }
+            ToolSpec::ToolSearch { description, .. } => {
+                (ToolName::plain("tool_search"), description.clone())
+            }
+            ToolSpec::WebSearch { .. } => (
+                ToolName::plain("web_search"),
+                "Search the web for information.".to_string(),
+            ),
+        };
+        candidates.insert(
+            key(&name),
+            Candidate {
+                name: name.with_default_namespace(),
+                description,
+                spec,
+            },
+        );
+    }
+    candidates
+}
+
+pub(crate) async fn select(
+    step: &StepContext,
+    prompt: &mut Prompt,
+    cancellation: &CancellationToken,
+) -> Result<()> {
+    let selectors = step
+        .mcp
+        .config()
+        .mcp_server_catalog
+        .configured_servers()
+        .into_iter()
+        .filter(|(name, config)| {
+            config.enabled
+                && config.disabled_reason.is_none()
+                && (name == "rippletide" || name.ends_with("_rippletide"))
+        })
+        .map(|(name, _)| name)
+        .collect::<Vec<_>>();
+    let selector = match selectors.as_slice() {
+        [] => return Ok(()),
+        [selector] => selector,
+        _ => {
+            return Err(CodexErr::Fatal(
+                "Multiple Rippletide selectors are enabled".to_string(),
+            ));
+        }
+    };
+    let mut candidates = catalog(step.tool_router.selection_specs(selector));
+    let tools = candidates.iter().map(|(name, candidate)| {
+        json!({"name": name, "description": if candidate.description.is_empty() { name } else { &candidate.description }})
+    }).collect::<Vec<_>>();
+    let question = prompt
+        .input
+        .iter()
+        .rev()
+        .find(|item| matches!(item, ResponseItem::Message { role, .. } if role == "user"));
+    let arguments = json!({
+        "context": serde_json::to_string(&json!({
+            "instructions": prompt.base_instructions.text,
+            "messages": prompt.input,
+        }))?,
+        "question": format!("Which tool should run next for this request? {}", serde_json::to_string(&question)?),
+        "tools": tools,
+    });
+    let call = step
+        .mcp
+        .prepare_call(selector, "route")
+        .ok_or_else(|| CodexErr::Fatal("Rippletide is unavailable".to_string()))?;
+    let result = tokio::select! {
+        _ = cancellation.cancelled() => return Err(CodexErr::TurnAborted),
+        result = call.call(Some(arguments), /*meta*/ None, /*timeout*/ None) => {
+            result.map_err(|error| CodexErr::Fatal(format!("Rippletide selection failed: {error}")))?
+        }
+    };
+    let response = result
+        .structured_content
+        .as_ref()
+        .ok_or_else(|| CodexErr::Fatal("Rippletide returned no selection".to_string()))?;
+    if result.is_error == Some(true) || response["status"] != "selected" {
+        return Err(CodexErr::Fatal(format!(
+            "Rippletide selection failed: {response}"
+        )));
+    }
+    let name = response["tool"].as_str().unwrap_or_default();
+    let selected = candidates
+        .remove(name)
+        .ok_or_else(|| CodexErr::Fatal("Rippletide selected an unavailable tool".to_string()))?;
+    step.tool_router.set_selection(Selection {
+        name: selected.name,
+        claimed: AtomicBool::new(false),
+    });
+    prompt.tools = vec![selected.spec].into();
+    prompt.parallel_tool_calls = false;
+    Ok(())
+}
+
+#[cfg(test)]
+#[path = "jev_tests.rs"]
+mod tests;
